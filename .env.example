# Isi di Vercel: Project > Settings > Environment Variables
SITE_URL=https://domainanda.com
PRODUCT_NAME=E-Book Modul Pelatihan F64 Ultra
PRODUCT_PRICE=199000

# Duitku Dashboard > Proyek Saya > (proyek) : Kode Merchant & API Key (Merchant Key)
DUITKU_MERCHANT_CODE=DXXXX
DUITKU_API_KEY=xxx
# sandbox = uji coba (pakai kode & key dari sandbox.duitku.com), production = transaksi sungguhan
DUITKU_ENV=sandbox

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxx
# Nama file master di bucket ebook-source
SOURCE_PDF_PATH=ebook.pdf

# Resend > API Keys. EMAIL_FROM wajib memakai domain yang sudah diverifikasi di Resend
RESEND_API_KEY=re_xxx
EMAIL_FROM=Quantum Telecommunication <ebook@domainanda.com>

# Nomor WA admin (format 628xxx, tanpa +)
SUPPORT_WHATSAPP=62XXXXXXXXXXX
# on = PDF dikunci password unik per pembeli, off = hanya watermark
PDF_PASSWORD=on
# String acak bebas (min. 16 karakter) untuk mengamankan cron anti-pause Supabase
CRON_SECRET=ganti-dengan-string-acak-panjang
# Masa berlaku link download (hari). Pembeli bisa minta link baru dari halaman sukses.
LINK_VALID_DAYS=7
