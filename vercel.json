{
  "functions": {
    "api/download.js": { "maxDuration": 60, "memory": 1024 },
    "api/xendit-webhook.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    { "source": "/sukses.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
